{
  "name": "react-strudel-kit",
  "version": "0.1.1",
  "description": "Typed Strudel pattern composition and shared React audio playback",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngvihoa/react-strudel-kit.git",
    "directory": "packages/react-strudel-kit"
  },
  "homepage": "https://react-strudel-kit.vercel.app/",
  "bugs": "https://github.com/ngvihoa/react-strudel-kit/issues",
  "keywords": ["strudel", "react", "typescript", "music", "live-coding"],
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "assets",
    "dist",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.type-test.*"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/src/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@strudel/mini": "1.2.6",
    "@strudel/web": "1.3.0"
  }
}
